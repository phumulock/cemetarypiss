package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    background: #000;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    font-family: 'Courier New', ui-monospace, monospace;
    color: #f0e8e0;
  }
  canvas#c { display: block; position: absolute; top: 0; left: 0; }

  .fire-strip {
    position: fixed;
    left: 0;
    right: 0;
    width: 100%;
    height: 25px;
    z-index: 4;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: block;
    pointer-events: none;
  }
  .fire-top    { top: 48px;    transform: scaleY(-1); }
  .fire-bottom { bottom: 40px; }

  @media (max-width: 1000px) {
    .fire-strip  { height: 20px; }
    .fire-top    { top: 44px; }
    .fire-bottom { bottom: 36px; }
  }
  @media (max-width: 600px) {
    .fire-strip  { height: 15px; }
    .fire-top    { top: 40px; }
    .fire-bottom { bottom: 32px; }
  }

  .navbar, .footer {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    padding: 0 18px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #c8b8a8;
    pointer-events: none;
    user-select: none;
  }
  .navbar {
    top: 0;
    height: 48px;
    justify-content: space-between;
    border-bottom: 1px solid rgba(120, 30, 30, 0.3);
  }
  .footer {
    bottom: 0;
    height: 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border-top: 1px solid rgba(120, 30, 30, 0.3);
    font-size: 10px;
    color: #886655;
  }
  .footer > :last-child { text-align: right; }
  .navbar .brand { font-style: italic; letter-spacing: 0.12em; color: #d8c8b8; }
  .navbar .links { display: flex; gap: 18px; }

  /* tablet / medium */
  @media (max-width: 1000px) {
    .navbar { height: 44px; padding: 0 14px; font-size: 10px; }
    .navbar .links { gap: 14px; }
    .footer { height: 36px; padding: 0 14px; font-size: 9px; }
  }

  /* phone / small */
  @media (max-width: 600px) {
    .navbar {
      height: 40px;
      padding: 0 12px;
      font-size: 9px;
      letter-spacing: 0.18em;
    }
    .navbar .links { gap: 10px; }
    .footer {
      height: 32px;
      padding: 0 12px;
      font-size: 8px;
      letter-spacing: 0.18em;
    }
  }

  .audio-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    pointer-events: auto;
  }
  .audio-toggle {
    background: transparent;
    border: 1px solid #3a0000;
    color: #7a0000;
    padding: 4px 12px;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    transition: background 0.2s, color 0.2s;
  }
  .audio-toggle:hover { background: #1a0000; color: #c00; }
  .audio-toggle.on { color: #c00; border-color: #5a0000; }
  .audio-nav {
    background: transparent;
    border: 1px solid #3a0000;
    color: #7a0000;
    padding: 4px 8px;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    cursor: pointer;
    pointer-events: auto;
    transition: background 0.2s, color 0.2s;
    line-height: 1;
  }
  .audio-nav:hover { background: #1a0000; color: #c00; }
			</style>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.1/bundles/datastar.js"></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
