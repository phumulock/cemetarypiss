package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    background: #000;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    font-family: 'Courier New', ui-monospace, monospace;
    color: #f0e8e0;
  }
  canvas#c { display: block; position: absolute; top: 0; left: 0; }

  :root { --navbar-h: 48px; --footer-h: 40px; }

  .fire-strip {
    position: fixed;
    left: 0;
    right: 0;
    width: 100%;
    height: 25px;
    z-index: 4;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: block;
    pointer-events: none;
  }
  .fire-top    { top: var(--navbar-h);    transform: scaleY(-1); }
  .fire-bottom { bottom: var(--footer-h); }

  @media (max-width: 1000px) {
    .fire-strip  { height: 20px; }
  }
  @media (max-width: 600px) {
    .fire-strip  { height: 15px; }
  }

  .navbar, .footer {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    padding: 0 18px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #c8b8a8;
    pointer-events: none;
    user-select: none;
  }
  .navbar {
    top: 0;
    height: var(--navbar-h);
    justify-content: space-between;
    border-bottom: 1px solid rgba(120, 30, 30, 0.3);
  }
  .footer {
    bottom: 0;
    height: var(--footer-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border-top: 1px solid rgba(120, 30, 30, 0.3);
    font-size: 10px;
    color: #886655;
  }
  .footer > :last-child { text-align: right; }
  .navbar .brand { font-style: italic; letter-spacing: 0.12em; color: #d8c8b8; }
  .navbar .links { display: flex; gap: 18px; }
  .navbar .links a {
    color: #c00;
    text-decoration: none;
    pointer-events: auto;
    transition: color 0.2s, text-shadow 0.2s;
  }
  .navbar .links a:hover {
    color: #f04040;
    text-shadow: 0 0 6px rgba(200, 0, 0, 0.6);
  }

  /* tablet / medium — chrome grows on smaller viewports so the nav/footer
     are easier to read and tap, and the logo (fit by height in this range)
     can fill more of the screen. */
  @media (max-width: 1000px) {
    :root { --navbar-h: 56px; --footer-h: 48px; }
    .navbar { padding: 0 16px; font-size: 11px; }
    .navbar .links { gap: 16px; }
    .footer { padding: 0 16px; font-size: 10px; }
    .audio-toggle { font-size: 11px; padding: 6px 14px; }
    .audio-nav    { font-size: 11px; padding: 6px 10px; }
  }

  /* phone / small */
  @media (max-width: 600px) {
    :root { --navbar-h: 84px; --footer-h: 80px; }
    .navbar {
      padding: 8px 14px;
      font-size: 10px;
      letter-spacing: 0.22em;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      gap: 8px;
    }
    .navbar .links {
      gap: 14px;
      justify-content: space-between;
    }
    .footer {
      padding: 0 14px;
      font-size: 9px;
      letter-spacing: 0.22em;
    }
    .audio-toggle { font-size: 10px; padding: 6px 12px; }
    .audio-nav    { font-size: 10px; padding: 6px 9px; }

    /* Stack the footer when audio controls are present: top row holds the
       buttons (centered), bottom row keeps est./baltimore on the sides.
       Footers without audio controls (e.g. /demo/logo) keep the 3-col row. */
    .footer:has(.audio-controls) {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      grid-template-areas:
        "audio audio"
        "left  right";
      row-gap: 6px;
      padding-top: 6px;
      padding-bottom: 6px;
    }
    .footer:has(.audio-controls) > :first-child    { grid-area: left;  align-self: center; }
    .footer:has(.audio-controls) > .audio-controls { grid-area: audio; justify-self: center; }
    .footer:has(.audio-controls) > :last-child     { grid-area: right; align-self: center; }
  }

  /* Landscape phones: vertical space is the constraint. The default fire
     font (keyed to viewport width) puts each 28-row strip at ~77px, eating
     ~40% of a 400px-tall viewport before the logo gets any room. Re-key the
     fire to viewport height and tighten the chrome so the logo gets a usable
     share of the band. Placed after the max-width breakpoints so it wins
     when a landscape phone matches both. */
  @media (orientation: landscape) and (max-height: 500px) {
    :root { --navbar-h: 40px; --footer-h: 36px; }
    .navbar { font-size: 11px; padding: 0 12px; }
    .footer { font-size: 10px; padding: 0 12px; }
    .audio-toggle { font-size: 10px; padding: 4px 10px; }
    .audio-nav    { font-size: 10px; padding: 4px 8px; }
    .fire-ascii { font-size: clamp(1.2px, 100vh / 320, 2.5px); }
    /* Home-page fire strips overlay the top/bottom of the logo canvas. On
       landscape phones vertical space is the constraint, so shrink the
       strip aggressively to expose more of the logo. */
    .fire-strip { height: 5px; }
  }

  .audio-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    pointer-events: auto;
  }
  .audio-toggle {
    background: transparent;
    border: 1px solid #3a0000;
    color: #7a0000;
    padding: 4px 12px;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    pointer-events: auto;
    transition: background 0.2s, color 0.2s;
  }
  .audio-toggle:hover { background: #1a0000; color: #c00; }
  .audio-toggle.on { color: #c00; border-color: #5a0000; }
  .audio-nav {
    background: transparent;
    border: 1px solid #3a0000;
    color: #7a0000;
    padding: 4px 8px;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    cursor: pointer;
    pointer-events: auto;
    transition: background 0.2s, color 0.2s;
    line-height: 1;
  }
  .audio-nav:hover { background: #1a0000; color: #c00; }

  /* /demo/logo — fill the middle band between navbar and footer */
  .logo-stage {
    position: fixed;
    top: var(--navbar-h);
    bottom: var(--footer-h);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* Lightning fills the entire band as a single pre behind the logo. Font-
     size is keyed to band height only — 180 rows always span the band edge
     to edge. On portrait viewports the 720 cols overflow horizontally and
     get clipped by .logo-stage's overflow:hidden, which is fine: bolts
     spawn across the full width so the visible center stays active. */
  #lightning {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    z-index: 0;
    font-family: 'Courier New', ui-monospace, monospace;
    line-height: 1;
    white-space: pre;
    color: rgba(190, 140, 240, 0.6);
    pointer-events: none;
    user-select: none;
    text-shadow: 0 0 4px rgba(170, 110, 230, 0.5);
    font-size: calc((100vh - var(--navbar-h) - var(--footer-h)) / 180);
    font-size: calc((100dvh - var(--navbar-h) - var(--footer-h)) / 180);
  }
  /* White-out when multiple bolts strike at once. Sits above the fire strips
     so it brightens the whole stage, with `screen` blend so it lifts existing
     colors rather than painting over them. Opacity is driven by the server's
     `_flash` signal (0..0.45); the short transition smooths the 20fps step
     into a continuous fade. Gradient runs near-fully-opaque at the center so
     the peak still reads on phones, which have lower peak luminance than
     desktops. */
  .lightning-flash {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center,
                  rgba(245, 235, 255, 1) 0%,
                  rgba(210, 190, 250, 0.55) 55%,
                  transparent 100%);
    mix-blend-mode: screen;
    opacity: 0;
    z-index: 3;
    pointer-events: none;
    transition: opacity 80ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightning-flash { display: none; }
  }
  .logo-slider {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 18px;
    background: #050505;
    border-bottom: 1px solid rgba(120, 30, 30, 0.3);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #886655;
  }
  .logo-slider input { flex: 1; accent-color: #7a0000; }
  .logo-box {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }
  .logo-box #logo {
    margin: 0;
    padding: 0;
    color: #f0e8e0;
    font-family: 'Courier New', ui-monospace, monospace;
    line-height: 1;
    white-space: pre;
    /* No `will-change: transform`: on iOS Safari it keeps the giant pre on a
       permanent composited layer, killing subpixel AA on the light text and
       making the whole logo read as gray/dim on mobile. The burst still
       composites momentarily during the transform frames, which is fine. */
    animation: logo-glitch 5s steps(1) infinite;
  }
  @keyframes logo-glitch {
    0%, 92%, 100% { transform: translate(0, 0); }
    95%           { transform: translate(-1px, 0); }
    95.5%           { transform: translate(1px, -1px); }
    96%           { transform: translate(-1px, 1px); }
    96.5%           { transform: translate(1px, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-box #logo { animation: none; }
  }
  /* Streamed ASCII fire strips framing the logo.
     fireW=1200 cols => width spans via 100vw/(1200*0.6)=100vw/720.
     clamp's upper cap kicks in at viewport=3960px (>4K); below that the
     content fills the full viewport. Lower cap keeps glyphs legible. */
  .fire-ascii {
    flex: 0 0 auto;
    margin: 0;
    width: 100%;
    overflow: hidden;
    color: #f0b048;
    font-family: 'Courier New', ui-monospace, monospace;
    line-height: 1;
    white-space: pre;
    font-size: clamp(2.75px, 100vw / 720, 5.5px);
    pointer-events: none;
    user-select: none;
    position: relative;
    z-index: 2;
  }
  /* Mask the strip so individual flames dim toward their cool tip instead of
     ending in a hard-edged character. Opaque ~30% on the hot side (the dense
     @-row against the navbar/footer), then linear fade to transparent at the
     logo edge. Tall heat bursts reaching into the faded region appear as soft
     tongues dissolving into smoke rather than abruptly cut-off glyphs. */
  #fire-top {
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 50%, transparent 100%);
  }
  #fire-bottom {
    -webkit-mask-image: linear-gradient(to top, #000 50%, transparent 100%);
            mask-image: linear-gradient(to top, #000 50%, transparent 100%);
  }
			</style>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.1/bundles/datastar.js"></script>
			// <script type="module" src="/static/datastar-inspector.js"></script>
		</head>
		<body>
			{ children... }
			<datastar-inspector></datastar-inspector>
		</body>
	</html>
}
